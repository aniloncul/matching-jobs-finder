{% for bullet in role.bullets %}\item {% if bullet.label %}\textbf{ {{- bullet.label|tex -}} }: {% endif %}{{ bullet.text|tex }}
{% endfor %}\end{itemize}
{% endif %}
{% endfor %}
{% endif %}
