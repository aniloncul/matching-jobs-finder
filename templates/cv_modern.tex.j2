{% for item in education %}\centry{ {{- item.degree|tex -}}{% if item.degree and item.institution %} -- {% endif %}{{- item.institution|tex -}} }{ {{- item.period|tex -}}{% if item.location %}, {{ item.location|tex }}{% endif %} }
{% endfor %}
{% endif %}
