{% raw %}
\newcommand{\cvsection}[1]{%
  \vspace{0.7em}%
  {\large\bfseries #1}%
  \par\nobreak\vspace{0.15em}%
  \rule{\linewidth}{0.4pt}%
  \par\nobreak\vspace{0.35em}%
}
\newcommand{\centry}[2]{%
  \noindent\textbf{#1}\hfill #2\par%
}
{% endraw %}

