# Secrets & personal state never go into the image - the Setup view writes
# them onto the mounted volume at runtime instead.
.env*
config/settings.local.json
config/google-service-account.json
config/profile.yaml*
config/cv.master.yaml
credentials/
data/
.browser-profiles/

# Repo noise
.git/
.github/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
tests/
reference-repos/
*.log
.DS_Store
*.bak

# Frontend builds inside the image
web/node_modules/
web/dist/

# Deploy artifacts / editor files
fly.launch*.toml
.fly/
.idea/
.vscode/
