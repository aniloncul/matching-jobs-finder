# Sheet sink
# Leave these empty to use data/jobs.csv instead.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service-account.json
GOOGLE_SHEET_URL=
SINK=auto

# Browser profiles
BROWSER_PROFILE_DIR=.browser-profiles

# UI
JOBSCOUT_HOST=127.0.0.1
JOBSCOUT_PORT=8000

# ==============================================================================
# Cover Letter LLM (NVIDIA NIM by default; local Ollama alternative below)
# ==============================================================================
COVER_LETTER_BASE_URL=https://integrate.api.nvidia.com/v1
COVER_LETTER_API_KEY=nvapi-...
COVER_LETTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
COVER_LETTER_TIMEOUT=300
COVER_LETTER_MAX_TOKENS=16384
COVER_LETTER_COMPILE_PDF=1
COVER_LETTER_DESCRIPTION_DIR=data/job_descriptions
COVER_LETTER_AUTO_DESCRIPTIONS=1
COVER_LETTER_AUTO_DESCRIPTION_LIMIT=10

# Local Ollama alternative:
# COVER_LETTER_BASE_URL=http://localhost:11434/v1
# COVER_LETTER_API_KEY=ollama
# COVER_LETTER_MODEL=qwen2.5:7b
# COVER_LETTER_MODEL_PROFILE=balanced

# Local Embedding Settings (Ollama native /api/embed)
COVER_LETTER_EMBED_BASE_URL=http://localhost:11434
COVER_LETTER_EMBED_MODEL=bge-m3
COVER_LETTER_SEMANTIC_WEIGHT=0.7
COVER_LETTER_KEYWORD_WEIGHT=0.3
COVER_LETTER_MATCH_THRESHOLD=0.25
COVER_LETTER_MAX_MATCHES=8

# CV Import Settings (Text extraction first, OCR fallback, vision fallback)
COVER_LETTER_VISION_MODEL=qwen2.5:7b
CV_IMPORT_MAX_PAGES=4
CV_IMPORT_MAX_UPLOAD_MB=12

# NVIDIA NIM vision model for CV import OCR fallback
COVER_LETTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
